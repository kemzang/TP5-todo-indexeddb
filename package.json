{
  "name": "todo-indexeddb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Application To-Do en JavaScript pur, taches rattachees a des projets, persistees via IndexedDB.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "cucumber-js",
    "test:bdd:ui": "cucumber-js -p navigateur",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:bdd && npm run test:bdd:ui && npm run test:e2e",
    "demo": "cucumber-js -p demo",
    "report:unit": "vite preview --outDir reports/vitest --port 4300 --open",
    "report:bdd": "xdg-open reports/cucumber-report.html",
    "report:bdd:ui": "xdg-open reports/cucumber-navigateur.html",
    "report:e2e": "playwright show-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "@playwright/test": "^1.49.1",
    "@vitest/ui": "^2.1.9",
    "fake-indexeddb": "^6.0.0",
    "http-server": "^14.1.1",
    "vitest": "^2.1.8"
  }
}
